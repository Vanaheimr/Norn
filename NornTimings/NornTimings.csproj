    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>org.GraphDefined.Vanaheimr.Norn.Timings</RootNamespace>
    <AssemblyName>norn-timings</AssemblyName>
